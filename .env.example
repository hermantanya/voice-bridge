# Copy to server/.env and fill in real values. NEVER commit server/.env.

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Streaming PTT spike (web): server relays OpenAI Realtime transcription
STREAMING_PTT_ENABLED=0
# Verbose streaming PTT logs (partials, chunks, session lifecycle)
# STREAMING_PTT_DEBUG=1
# Optional ASR model for realtime intent=transcription
# STREAMING_PTT_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Server port (Railway sets PORT automatically)
PORT=3001

# Comma-separated allowed origins for CORS/WebSocket, or * for dev
CLIENT_ORIGIN=*

# Rate limits (protect OpenAI credits if the repo/server is public)
RATE_LIMIT_TRANSLATE_PER_HOUR=30
RATE_LIMIT_AUDIO_PER_HOUR=120
RATE_LIMIT_JOIN_PER_MINUTE=20

# Auth (v1.4 phase 1) — email OTP + JWT sessions; user profiles on disk
AUTH_JWT_SECRET=generate-a-long-random-string
AUTH_JWT_TTL_DAYS=30
USER_DATA_DIR=./data/users
# Optional: Resend (https://resend.com) for OTP email in production
RESEND_API_KEY=
AUTH_FROM_EMAIL=Voice Bridge <onboarding@yourdomain.com>
# Dev only: include OTP in /api/auth/request-otp JSON (never enable in production)
AUTH_DEV_RETURN_OTP=false
