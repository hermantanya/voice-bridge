{
  "name": "voice-bridge-server",
  "version": "1.2.0",
  "description": "Real-time voice translation backend (EN, HE, RU). Socket.io + OpenAI Whisper/GPT + ElevenLabs TTS.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/ws/roomParticipants.test.ts src/ws/join-room.integration.test.ts src/pipeline/genderInstruction.test.ts src/voices/enrollment.test.ts",
    "verify:regressions": "node ../apps/mobile/scripts/verify-regressions.mjs",
    "spike:voice": "tsx scripts/spike-custom-voice.ts",
    "spike:voice:fish": "tsx scripts/spike-custom-voice-fish.ts",
    "spike:voice:elevenlabs": "tsx scripts/spike-custom-voice-elevenlabs.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
