OPENAI_API_KEY=sk-your-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
FISH_API_KEY=your-fish-api-key-here
PORT=3001
CLIENT_ORIGIN=*

# Rate limits (protects API credits on a public deployment)
RATE_LIMIT_TRANSLATE_PER_HOUR=30
RATE_LIMIT_ENROLL_PER_HOUR=10
RATE_LIMIT_AUDIO_PER_HOUR=120
RATE_LIMIT_JOIN_PER_MINUTE=20

AUTH_JWT_SECRET=generate-a-long-random-string
AUTH_JWT_TTL_DAYS=30

# Supabase Postgres (Session pooler URI). When set, user accounts live in Postgres;
# when unset, dev/tests use a JSON file under USER_DATA_DIR.
DATABASE_URL=
USER_DATA_DIR=./data/users
RESEND_API_KEY=
AUTH_FROM_EMAIL=Voice Bridge <onboarding@yourdomain.com>
AUTH_DEV_RETURN_OTP=false
