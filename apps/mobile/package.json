{
  "name": "mobile",
  "version": "1.3.0",
  "description": "Real-time voice translation app (English, Hebrew, Russian). Expo for iOS, Android, and web. Cloned voice enrollment.",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-file-system": "~19.0.23",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "verify:settings": "node scripts/verify-settings-screen.mjs",
    "verify:regressions": "node scripts/verify-regressions.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify": "npm run verify:settings && npm run verify:regressions && npm run verify:docs"
  },
  "private": true
}
