{
  "name": "mobile",
  "version": "1.3.0",
  "description": "Real-time voice translation app (English, Hebrew, Russian). Expo for iOS, Android, and web. Cloned voice enrollment.",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "verify:settings": "node scripts/verify-settings-screen.mjs",
    "verify:regressions": "node scripts/verify-regressions.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify": "npm run verify:settings && npm run verify:regressions && npm run verify:docs"
  },
  "private": true
}
